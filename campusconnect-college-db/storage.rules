rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'Administrator';
    }

    function isFaculty() {
      return isAuthenticated() && (
        request.auth.token.role == 'Faculty' ||
        request.auth.token.role == 'HOD' ||
        isAdmin()
      );
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdfOrDoc() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*');
    }

    function isCompressedOrCode() {
      return request.resource.contentType.matches('application/zip') ||
             request.resource.contentType.matches('application/x-zip-compressed') ||
             request.resource.contentType.matches('text/.*');
    }

    // 1. Student Profiles: Images only, max 5MB
    match /student_profiles/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImageFile() && request.resource.size <= 5 * 1024 * 1024;
    }

    // 2. Faculty Profiles: Images only, max 5MB
    match /faculty_profiles/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImageFile() && request.resource.size <= 5 * 1024 * 1024;
    }

    // 3. Student Certificates: PDF or images, max 10MB
    match /student_certificates/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && (isPdfOrDoc() || isImageFile()) && request.resource.size <= 10 * 1024 * 1024;
    }

    // 4. Student Resumes: PDF only, max 5MB
    match /student_resumes/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && request.resource.contentType == 'application/pdf' && request.resource.size <= 5 * 1024 * 1024;
    }

    // 5. Assignment Files: PDF, Docx, Zip by Faculty, max 25MB
    match /assignment_files/{subjectId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() && request.resource.size <= 25 * 1024 * 1024;
    }

    // 6. Assignment Submissions: PDF or Zip by enrolled student, max 20MB
    match /assignment_submissions/{assignmentId}/{studentId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(studentId) || isFaculty());
      allow write: if isOwner(studentId) && (isPdfOrDoc() || isCompressedOrCode()) && request.resource.size <= 20 * 1024 * 1024;
    }

    // 7. Event Attachments: Images, posters, docs, max 15MB
    match /event_attachments/{eventId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isFaculty() || isAdmin();
    }

    // 8. Complaint Attachments: Images or PDF, max 10MB
    match /complaint_attachments/{userId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId) && request.resource.size <= 10 * 1024 * 1024;
    }

    // 9. College Documents & Circulars: Read by all, written only by Admin
    match /college_documents/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && request.resource.size <= 50 * 1024 * 1024;
    }
  }
}
