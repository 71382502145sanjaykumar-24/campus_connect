# Firebase Configuration & Credentials Template
# Rename this file to .env and configure with your Firebase Project details

FIREBASE_PROJECT_ID=campusconnect-college-db
FIREBASE_STORAGE_BUCKET=campusconnect-college-db.appspot.com

# Path to service account key JSON file (obtained from Firebase Console -> Project Settings -> Service Accounts)
# DO NOT COMMIT THE ACTUAL JSON KEY FILE TO VERSION CONTROL
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Local Emulator Suite (Optional: set to true to test against local emulators)
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Administrative seed defaults (Used only during initial seed script execution)
DEFAULT_ADMIN_EMAIL=admin@college.com
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_ROLE=Administrator
